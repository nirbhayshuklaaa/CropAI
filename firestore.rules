rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.preferredLanguage is string && data.preferredLanguage.size() <= 10 &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('village' in data) || (data.village is string && data.village.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSoilReport(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.soilCategory is string && data.soilCategory.size() <= 100 &&
             data.source in ['AI_ESTIMATE', 'LAB_TESTED', 'USER_ENTERED'] &&
             (!('nitrogen' in data) || data.nitrogen is number) &&
             (!('phosphorus' in data) || data.phosphorus is number) &&
             (!('potassium' in data) || data.potassium is number) &&
             (!('ph' in data) || data.ph is number) &&
             (!('moisture' in data) || data.moisture is number) &&
             (!('confidence' in data) || data.confidence is number) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidFarm(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('state' in data) || (data.state is string && data.state.size() <= 100)) &&
             (!('district' in data) || (data.district is string && data.district.size() <= 100)) &&
             (!('village' in data) || (data.village is string && data.village.size() <= 100)) &&
             (!('totalAcreage' in data) || data.totalAcreage is number) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidField(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('acreage' in data) || data.acreage is number) &&
             (!('currentCrop' in data) || (data.currentCrop is string && data.currentCrop.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidFeedback(data) {
      return data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.isUseful is bool &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000)) &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // User profiles cannot be bulk scraped
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);

      // Farms Subcollection
      match /farms/{farmId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFarm(incoming());
        allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidFarm(incoming());
        allow delete: if isOwner(userId);

        // Fields Subcollection
        match /fields/{fieldId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidField(incoming());
          allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidField(incoming());
          allow delete: if isOwner(userId);
        }
      }

      // Soil Reports Subcollection
      match /soil_reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSoilReport(incoming());
        allow update: if isOwner(userId) && incoming().userId == existing().userId && isValidSoilReport(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Public Read-Only Agricultural Catalogs
    match /crops/{cropId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /fertilizers/{fertilizerId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow get, list: if true;
      allow write: if false;
    }

    // Farmer Feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidFeedback(incoming());
      allow read, update, delete: if false;
    }
  }
}
