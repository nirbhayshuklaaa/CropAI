{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Farmer profile storing preferences and contact details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "village": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "preferredLanguage"]
    },
    "SoilReport": {
      "title": "SoilReport",
      "description": "Soil analysis report with NPK, pH, moisture, and confidence estimates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "farmId": { "type": "string" },
        "soilCategory": { "type": "string" },
        "nitrogen": { "type": "number" },
        "phosphorus": { "type": "number" },
        "potassium": { "type": "number" },
        "ph": { "type": "number" },
        "moisture": { "type": "number" },
        "source": { "type": "string", "enum": ["AI_ESTIMATE", "LAB_TESTED", "USER_ENTERED"] },
        "confidence": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "soilCategory", "source"]
    },
    "Farm": {
      "title": "Farm",
      "description": "Farmer's registered agricultural holding",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "village": { "type": "string" },
        "totalAcreage": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name"]
    },
    "Field": {
      "title": "Field",
      "description": "Individual plot / field inside a farm",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "farmId": { "type": "string" },
        "name": { "type": "string" },
        "acreage": { "type": "number" },
        "currentCrop": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "farmId", "name"]
    },
    "Crop": {
      "title": "Crop",
      "description": "Scientific agronomic catalog item for crops",
      "type": "object",
      "properties": {
        "cropId": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameHi": { "type": "string" },
        "scientificName": { "type": "string" },
        "growingSeason": { "type": "string" },
        "durationDays": { "type": "integer" }
      },
      "required": ["cropId", "nameEn", "nameHi"]
    },
    "Product": {
      "title": "Product",
      "description": "Verified agricultural input product with legitimate purchasing URL",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameHi": { "type": "string" },
        "category": { "type": "string" },
        "priceInr": { "type": "number" },
        "externalUrl": { "type": "string" }
      },
      "required": ["id", "nameEn", "category", "priceInr", "externalUrl"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Farmer feedback on agronomic recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "recommendationId": { "type": "string" },
        "isUseful": { "type": "boolean" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "isUseful"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Farmer profiles keyed by authenticated user ID"
    },
    "/users/{userId}/farms/{farmId}": {
      "schema": { "$ref": "#/entities/Farm" },
      "description": "Farms owned by the farmer"
    },
    "/users/{userId}/farms/{farmId}/fields/{fieldId}": {
      "schema": { "$ref": "#/entities/Field" },
      "description": "Fields in a farm"
    },
    "/users/{userId}/soil_reports/{reportId}": {
      "schema": { "$ref": "#/entities/SoilReport" },
      "description": "Saved soil reports"
    },
    "/crops/{cropId}": {
      "schema": { "$ref": "#/entities/Crop" },
      "description": "Public catalog of Indian crops"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public verified product catalog with external links"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Farmer feedback collection"
    }
  }
}
